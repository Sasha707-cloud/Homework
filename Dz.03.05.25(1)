namespace Lessons2
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Player player = new Player();

            player.Name = "Вика";

            player.Level = 1;

            player.ShowInfo();
        }
    }

    public class Player
    {
        public string Name;

        public int Level;

        public void ShowInfo()
        {
            Console.WriteLine("Информация о игроке:");
            Console.WriteLine($"Имя: {Name}");
            Console.WriteLine($"Уровень: {Level}");
        }


    }

